{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "generated"],
    "exclude": ["node_modules", "dist"]
}